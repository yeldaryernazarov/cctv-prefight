# Database Configuration
DATABASE_URL=postgresql+asyncpg://riskuser:riskpass123@postgres:5432/risk_detection
POSTGRES_DB=risk_detection
POSTGRES_USER=riskuser
POSTGRES_PASSWORD=riskpass123

# Redis Configuration
REDIS_URL=redis://redis:6379

# Service URLs (internal)
RISK_ENGINE_URL=http://risk-engine:8001
CLIP_SERVICE_URL=http://clip-service:8002

# Clip Service Configuration
STORAGE_PATH=/app/clips
RING_BUFFER_SECONDS=60
CLIP_PRE_SECONDS=10
CLIP_POST_SECONDS=10

# Analytics Configuration
CONFIG_PATH=/app/config/analytics_config.yaml

# JWT Secret (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-this-in-production-use-strong-random-string

# React App Configuration
REACT_APP_API_URL=http://localhost:8001
REACT_APP_CLIP_SERVICE_URL=http://localhost:8002

# GPU Configuration
NVIDIA_VISIBLE_DEVICES=all
